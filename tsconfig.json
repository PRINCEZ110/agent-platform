{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@providers/*": ["src/providers/*"],
      "@tools/*": ["src/tools/*"],
      "@git/*": ["src/git/*"],
      "@comm/*": ["src/comm/*"],
      "@memory/*": ["src/memory/*"],
      "@tasks/*": ["src/tasks/*"],
      "@safety/*": ["src/safety/*"],
      "@obs/*": ["src/obs/*"],
      "@agents/*": ["src/agents/*"],
      "@types/*": ["src/types/*"],
      "@app/*": ["src/app/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/*.spec.ts", "src/_excluded/**"]
}